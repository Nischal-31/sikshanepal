# Django secret & debug
SECRET_KEY=change-me
DEBUG=False

# Hosts / origins — update these if your domain or IP changes, no code change needed
ALLOWED_HOSTS=your-ec2-ip,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://your-ec2-ip,http://127.0.0.1:8000

# PostgreSQL
DB_NAME=db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Email settings (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=change-me

# Auto-created Django admin (first deploy only)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
